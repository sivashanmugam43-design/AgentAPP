# Copy to .env. All settings are optional; defaults shown.

# Hugging Face token for the gated IndicTrans2 model (translate.py). Create one at
# https://huggingface.co/settings/tokens after accepting the terms on
# https://huggingface.co/ai4bharat/indictrans2-indic-en-dist-200M
# HF_TOKEN=

# Politeness (CONCURRENCY is capped at 3)
# CONCURRENCY=3
# DELAY_MIN=1.0
# DELAY_MAX=2.0
# MAX_ATTEMPTS=5
# BACKOFF_BASE=2.0
# HTTP_TIMEOUT=30
# OUTPUT_DIR=output
