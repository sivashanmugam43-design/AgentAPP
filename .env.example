# Copy to .env. Only ANTHROPIC_API_KEY is needed (for machine translation); the rest show defaults.
ANTHROPIC_API_KEY=
# TRANSLATE_MODEL=claude-haiku-4-5
# TRANSLATE_CHUNK_CHARS=1000

# Politeness (CONCURRENCY is capped at 3)
# CONCURRENCY=3
# DELAY_MIN=1.0
# DELAY_MAX=2.0
# MAX_ATTEMPTS=5
# BACKOFF_BASE=2.0
# HTTP_TIMEOUT=30
# OUTPUT_DIR=output
